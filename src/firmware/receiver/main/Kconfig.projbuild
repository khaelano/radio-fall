menu "CSI receiver"

config CSI_CHANNEL
    int "Wi-Fi channel"
    range 1 11
    default 11
    help
        Fixed 2.4 GHz channel used for the ESP-NOW sensing packets.

config CSI_SEND_MAC
    string "Transmitter MAC address"
    default "1a:00:00:00:00:00"
    help
        MAC address of the transmitter whose packets should be logged.

endmenu
