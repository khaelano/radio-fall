menu "CSI receiver"

choice CSI_BAND
    prompt "Wi-Fi band"
    default CSI_BAND_2G
    help
        The fallback band used until a USB-provisioned profile is present.

config CSI_BAND_2G
    bool "2.4 GHz"

config CSI_BAND_5G
    bool "5 GHz (ESP32-C5 only)"

endchoice

config CSI_CHANNEL
    int "Wi-Fi channel"
    range 1 14
    default 6
    help
        Safe 2.4 GHz fallback channel used before USB provisioning. A
        provisioned profile replaces this value at runtime.

config CSI_SEND_MAC
    string "Transmitter MAC address"
    default "1a:00:00:00:00:00"
    help
        MAC address of the transmitter whose packets should be logged.

config CSI_GATEWAY_EVENT_UPLOAD
    bool "Experimental event-driven gateway upload worker"
    default n
    help
        Submit upload frames without a fixed post-submit wait and wake the
        worker on MAC completion or incoming messages. Keep one send in flight
        and retain the configured slot, send cutoff and channel return reserve.

config CSI_USB_CONTROL
    bool "USB profile provisioning control"
    default y
    help
        Expose discovery and staged radio-profile provisioning over the
        native USB Serial/JTAG interface.

endmenu
