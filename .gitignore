# Local indexes, caches and test output
tools/**/.rag-index/
__pycache__/
*.pyc
**/.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.pytest_cache/

# ESP-IDF output and local configuration
**/build*/
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.ble
**/sdkconfig.ble.old

# Python environments and generated metadata
.venv/
src/*.egg-info/

# Local thesis drafts, data and literature
/draft/
/resources/

# Regenerable figures
/docs/figures/

# Artifact subdirectories are DVC outputs; their .dvc files stay in Git. Name
# each output: DVC skips any .dvc file or directory its Git library reports as
# ignored, and that library treats both `/artifacts/*` (despite a negation) and
# `/artifacts/*/` as ignoring the .dvc files, so DVC commands without targets
# skipped these outputs. Add a line for each new artifact directory.
/artifacts/model/
/artifacts/notebooks/

# Codex artifacts
.codex-build/
.codex-finalizer/
.jupyter-agent-bridge/

# Rust build output and native extension
**/target/
src/fall_detection/_radio_native*.so

# Re-include repository guides hidden by the global ignore rules
!AGENTS.md
!docs/
